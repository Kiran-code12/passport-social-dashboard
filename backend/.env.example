# Supabase project credentials (required). Create a project at supabase.com
# and create a `posts` table before starting the backend.
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_api_key

# YouTube Data API v3 key (required for the YouTube scraper).
YOUTUBE_API_KEY=your_youtube_api_key

# Bluesky app account used to search posts (required for the Bluesky scraper).
# Create an app password at bsky.app, do not use your main account password.
BLUESKY_IDENTIFIER=your_bluesky_handle_or_email
BLUESKY_APP_PASSWORD=your_bluesky_app_password

# Bluesky API host (optional, defaults to https://api.bsky.app).
BLUESKY_SEARCH_HOST=https://api.bsky.app

# Port the Express server listens on (optional, defaults to 5000).
PORT=5000

# How often the scraper cycle repeats, in minutes (optional, defaults to 20).
SCRAPE_INTERVAL_MINUTES=20

# Whether to run a scrape cycle immediately on startup, in addition to the
# recurring interval above (optional, defaults to true; set to "false" to
# disable the immediate run).
SCRAPE_ON_STARTUP=true

# Translation mode: "local" uses local Xenova ONNX models in a worker thread
# (slower on low-memory hosts); "remote" uses the free MyMemory API instead
# (optional, defaults to "local").
TRANSLATION_MODE=local

# Email to send with MyMemory API requests when TRANSLATION_MODE=remote.
# Raises MyMemory's free daily character limit from 5,000 to 50,000
# (optional, no email is sent if unset).
MYMEMORY_EMAIL=

# Whether to pre-load every local translation model at startup instead of
# loading each one lazily on first use (optional, defaults to "false"; has
# no effect when TRANSLATION_MODE=remote). Only relevant when using local
# translation models.
WARM_UP_MODELS=false

# LibreTranslate endpoint used only for Punjabi translation when
# TRANSLATION_MODE=local (Punjabi has no local ONNX model). Optional,
# defaults to the public https://libretranslate.com/translate endpoint.
LIBRETRANSLATE_URL=https://libretranslate.com/translate

# API key for the LibreTranslate endpoint above (optional; the public
# instance may reject requests without one).
LIBRETRANSLATE_API_KEY=
